classDiagram
  class Config {
    +str glob
    +Path output
    +Path diagram
    +str encoding
    +Path base_dir
    +defaults()
    +load()
  }
  class EntityKind {
    <<enumeration>>
    MODULE
    FUNCTION
    METHOD
    CLASS
    STRUCT
    ENUM
    TRAIT
    INTERFACE
  }
  class Param {
    +str name
    +str type
    +str direction
    +str description
  }
  class Variant {
    +str name
    +str description
  }
  class Field {
    +str name
    +str type
    +str visibility
    +bool static
    +str description
  }
  class Doc {
    +str brief
    +str details
    +list~Param~ params
    +str returns
    +list~tuple~str, str~~ throws
    +list~str~ see
    +list~str~ notes
    +list~str~ warnings
    +list~str~ examples
  }
  class Entity {
    +EntityKind kind
    +str name
    +str signature
    +str return_type
    +Doc doc
    +bool abstract
    +list~Entity~ members
    +list~Variant~ variants
    +list~Field~ fields
    +list~str~ bases
    +list~str~ implements
    +str module
    +str path
    +int line
    +list~str~ calls
    +list~str~ includes
  }
  class DocParser {
    +parse()
  }
  class Language {
    <<abstract>>
    +tuple~str, ...~ extensions
    +parse()
    +consume_block()
  }
  class PythonLanguage {
    +parse()
  }
  class RustLanguage {
    +parse()
  }
  class CppLanguage {
    +parse()
  }
  class ReferenceRenderer {
    +render()
  }
  class MermaidRenderer {
    +render()
    +class_diagram()
    +inheritance_diagram()
    +collaboration_diagram()
    +call_graph()
    +caller_graph()
    +include_graph()
    +directory_graph()
  }
  class Converter {
    +Config cfg
    +renderer
    +__init__()
    +entities()
    +file()
    +project()
    +diagram()
    +files()
  }
  class Scaffolder {
    +Path target
    +bool force
    +__init__()
    +run()
  }
  Doc ..> Param
  Entity ..> EntityKind
  Entity ..> Doc
  Entity ..> Variant
  Entity ..> Field
  Language <|-- PythonLanguage
  Language <|-- RustLanguage
  Language <|-- CppLanguage
  Converter ..> Config
